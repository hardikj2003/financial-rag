{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": ["src", "prisma", "prisma.config.ts"],

  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts"
  ]
}