generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Chat {
  id String @id @default(uuid())
  title String @default("New Financial Chat")
  createdAt DateTime @default(now())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  role      String
  content   String
  createdAt DateTime @default(now())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Document {
  id           String   @id @default(uuid())
  fileName     String
  chunksStored Int
  createdAt    DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id
  email     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  chats     Chat[]
}
